<UserControl x:Class="Shower.App.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Shower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ParametersViewModel}"
             d:DesignWidth="1300" d:DesignHeight="700">
    <UserControl.Resources>
        <!-- Подпись изменённого, но ещё не записанного параметра выделяется цветом. -->
        <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type vm:ParameterViewModel}">
            <StackPanel Margin="0,0,0,12" ToolTip="{Binding Hint}">
                <TextBlock x:Name="Caption" Margin="0,0,0,4" Text="{Binding Caption}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ToolPanel}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Запросить" Command="{Binding LoadCommand}"
                        ToolTip="Считать параметры с контроллера" />
                <Button Content="Очистить" Command="{Binding ClearCommand}" />
                <Button Content="Записать" Command="{Binding SaveCommand}"
                        ToolTip="Записать изменённые параметры в контроллер" />
                <Button Content="Перезапуск" Command="{Binding RestartCommand}" />
                <Button Content="Отмена" Command="{Binding CancelCommand}" />
                <Button Content="Экспорт" Command="{Binding ExportCommand}"
                        ToolTip="Сохранить параметры в файл" />
                <Button Content="Импорт" Command="{Binding ImportCommand}"
                        ToolTip="Загрузить параметры из файла. Отличающиеся значения будут записаны по кнопке «Записать»" />
                <ProgressBar Width="120" Margin="16,0,0,0" VerticalAlignment="Center" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" Margin="16" VerticalAlignment="Top" IsEnabled="{Binding IsEditable}">
                <ItemsControl Width="320" Focusable="False"
                              ItemsSource="{Binding LeftColumn}" ItemTemplate="{StaticResource ParameterTemplate}" />

                <StackPanel Width="360" Margin="32,0,0,0">
                    <ItemsControl Focusable="False"
                                  ItemsSource="{Binding RightColumn}" ItemTemplate="{StaticResource ParameterTemplate}" />
                    <CheckBox Content="Watchdog" IsThreeState="True" IsHitTestVisible="False" Focusable="False"
                              IsChecked="{Binding WatchDogWasReset, Mode=OneWay}"
                              ToolTip="Сработал ли сторожевой таймер контроллера с прошлого запуска" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
